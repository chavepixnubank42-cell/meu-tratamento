# =========================================================
# MEU TRATAMENTO — Variáveis de ambiente (EXEMPLO)
# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA coloque valores reais neste arquivo (.env.example)
# e NUNCA faça commit do arquivo ".env" real.
# =========================================================

# --- Supabase (frontend) ---
# Encontre em: Supabase Dashboard > Project Settings > API
# A ANON KEY é pública por design (protegida pelas políticas RLS),
# mas ainda assim não deve ser exposta desnecessariamente.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# --- Supabase (apenas backend/servidor - NUNCA no app mobile) ---
# Usada somente em funções server-side (ex: Vercel Serverless / Supabase Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=NUNCA_EXPOR_NO_APP_MOBILE

# --- IA (Gemini) — usada SOMENTE no backend/servidor ---
# Esta chave jamais deve ir para o app mobile. O app chama uma
# rota do backend (ex: Vercel), e é o backend que chama a IA.
GEMINI_API_KEY=sua_chave_gemini_aqui

# --- Backend (Vercel) — rotas chamadas pelo app ---
# URL da função /api/assistant após o deploy (ver backend/README.md)
EXPO_PUBLIC_AI_BACKEND_URL=https://seu-projeto.vercel.app/api/assistant

# URL da função /api/delete-account após o deploy — necessária para a
# exclusão de conta funcionar com o Supabase configurado (Fase 10)
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://seu-projeto.vercel.app/api/delete-account

# --- Feature flags gerais ---
# Controla se a camada de IA está habilitada (mesmo em modo mock)
EXPO_PUBLIC_AI_ENABLED=true

# Controla se, durante o desenvolvimento, todos os recursos
# Premium ficam liberados para teste (ver src/config/featureFlags.ts)
EXPO_PUBLIC_PREMIUM_FREE_FOR_ALL=true

# --- Ambiente ---
EXPO_PUBLIC_APP_ENV=development
