# =========================================================
# MEU TRATAMENTO — Backend (Vercel) — variáveis de ambiente
# Configure estas variáveis no painel da Vercel
# (Project Settings > Environment Variables), NUNCA em um
# arquivo .env commitado.
# =========================================================

# Mesma URL do projeto usada no app (Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Service role key — ignora RLS. Só existe aqui, nunca no app mobile.
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Chave da Gemini API (Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui
